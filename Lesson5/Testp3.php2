<?php
$name   = "สมชาย";       // String
$age    = 30;              // Integer
$gpa    = 3.75;            // Float
$active = true;            // Boolean
$note   = null;            // NULL

define("PI", 3.14159);
?>
<!doctype html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Task 3 · ตัวแปรใน PHP</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <main class="lesson">
        <a class="back" href="index.html">← กลับ Lesson 5</a>
        <header class="hero">
            <span class="tag">TASK 03 · PHP</span>
            <h1>ตัวแปรและชนิดข้อมูล</h1>
            <p>ตัวแปรขึ้นต้นด้วย <code>$</code> และชื่อตัวแปรแยกตัวพิมพ์ใหญ่-เล็ก</p>
        </header>

        <section class="result-grid">
            <article class="result-card">
                <h2>String · gettype()</h2>
                <p class="result"><?php echo gettype($name); // string ?></p>
            </article>
            <article class="result-card">
                <h2>Integer · var_dump()</h2>
                <pre><?php var_dump($age); // int(30) ?></pre>
            </article>
            <article class="result-card">
                <h2>Float</h2>
                <p class="result"><?php echo gettype($gpa); ?> · <?= $gpa ?></p>
            </article>
            <article class="result-card">
                <h2>Boolean</h2>
                <p class="result"><?php echo gettype($active); ?> · <?= $active ? "true" : "false" ?></p>
            </article>
            <article class="result-card">
                <h2>NULL</h2>
                <p class="result"><?php echo gettype($note); ?></p>
            </article>
            <article class="result-card">
                <h2>ค่าคงที่</h2>
                <p class="result">PI = <?php echo PI; ?></p>
            </article>
        </section>

        <p class="message"><?php
            // String interpolation (ใส่ตัวแปรใน "")
            echo "ชื่อ: $name อายุ: $age ปี";
        ?></p>
    </main>
</body>
</html>
